# ══════════════════════════════════════════════════════════════
# GoodDoctor's Shop — Modèle Variables d'Environnement (.env.example)
# ══════════════════════════════════════════════════════════════

# Supabase (Client Vite & Next)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (Serveur Netlify & Edge Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Coordonnées Siège GoodDoctor's Lomé
VITE_GD_HQ_LAT=6.193257
VITE_GD_HQ_LNG=1.203326

# Backoffice & URL Site
SITE_URL=https://gooddoctorsshop.com
VITE_SITE_URL=https://gooddoctorsshop.com
BACKOFFICE_BASE_URL=https://your-backoffice.netlify.app/web-orders
BACKOFFICE_WEBHOOK_SECRET=your-webhook-secret-here

# Notifications Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:contact@gooddoctorsshop.com

# CashPay API Production
CASHPAY_BASE_URL=https://api.semoa-payments.ovh/prod
CASHPAY_CLIENT_ID=your-cashpay-client-id
CASHPAY_USERNAME=your-cashpay-username
CASHPAY_CLIENT_SECRET=
CASHPAY_PASSWORD=
CASHPAY_API_KEY=
